# The gate in front of your model server (docs/local-models.md). With MODEL_API_KEY unset it answers 401 to everything.
#   Public IP:  GATE_ADDRESS=llm.example.org MODEL_API_KEY=... caddy run --config Caddyfile
#               (Caddy fetches the certificate for that name; open ports 80 and 443)
#   Tunnel:     MODEL_API_KEY=... caddy run --config Caddyfile
#               (plain HTTP on port 8090 for the tunnel to connect to)
{$GATE_ADDRESS::8090} {
	@model {
		path /v1/*
		# the header matcher would read a * in the key as a wildcard, so the key is compared exactly
		expression `{env.MODEL_API_KEY} != "" && {header.Authorization} == "Bearer " + {env.MODEL_API_KEY}`
	}
	handle @model {
		reverse_proxy {$MODEL_SERVER:127.0.0.1:8000} {
			header_up Host {upstream_hostport} # Ollama accepts only local Host names
		}
	}
	handle {
		respond 401
	}
}
